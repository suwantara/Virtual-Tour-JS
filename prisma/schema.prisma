generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                     String    @id @default(cuid())
  name                   String
  email                  String    @unique
  emailVerified          DateTime? @map("email_verified_at")
  password               String
  role                   String    @default("viewer")
  twoFactorSecret        String?   @map("two_factor_secret")
  twoFactorRecoveryCodes String?   @map("two_factor_recovery_codes")
  twoFactorConfirmedAt   DateTime? @map("two_factor_confirmed_at")
  image                  String?
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  accounts  Account[]
  sessions  Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token")
  accessToken       String? @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token")
  sessionState      String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  email     String    @id
  token     String
  createdAt DateTime? @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  venues Venue[]

  @@map("categories")
}

model Venue {
  id            Int      @id @default(autoincrement())
  categoryId    Int?     @map("category_id")
  name          String
  slug          String   @unique
  description   String?
  thumbnailPath String?  @map("thumbnail_path")
  isPublished   Boolean  @default(false) @map("is_published")
  coverSceneId  Int?     @map("cover_scene_id")
  viewCount     Int      @default(0) @map("view_count")
  primaryColor  String   @default("#6366f1") @map("primary_color")
  logoPath      String?  @map("logo_path")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  coverScene Scene?    @relation("VenueCover", fields: [coverSceneId], references: [id], onDelete: SetNull)
  scenes     Scene[]

  @@map("venues")
}

model Scene {
  id             Int      @id @default(autoincrement())
  venueId        Int      @map("venue_id")
  name           String
  localName      String?  @map("local_name")
  description    String?
  era            String?
  ritualFunction String?  @map("ritual_function")
  material       String?
  imagePath      String?  @map("image_path")
  audioPath      String?  @map("audio_path")
  initialYaw     Float    @default(0) @map("initial_yaw")
  initialPitch   Float    @default(0) @map("initial_pitch")
  order          Int      @default(0)
  isPublished    Boolean  @default(true) @map("is_published")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  venue           Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  hotspots        Hotspot[] @relation("SceneHotspots")
  incomingLinks   Hotspot[] @relation("SceneTargetLinks")
  venueAsCover    Venue[]   @relation("VenueCover")

  @@map("scenes")
}

model Hotspot {
  id            Int      @id @default(autoincrement())
  sceneId       Int      @map("scene_id")
  type          String
  label         String
  description   String?
  imagePath     String?  @map("image_path")
  pitch         Float    @default(0)
  yaw           Float    @default(0)
  iconColor     String?  @map("icon_color")
  iconPath      String?  @map("icon_path")
  targetSceneId Int?     @map("target_scene_id")
  url           String?
  mediaUrl      String?  @map("media_url")
  mediaType     String?  @map("media_type")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  scene       Scene  @relation("SceneHotspots", fields: [sceneId], references: [id], onDelete: Cascade)
  targetScene Scene? @relation("SceneTargetLinks", fields: [targetSceneId], references: [id], onDelete: SetNull)

  @@map("hotspots")
}

model SiteSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model WikiCategory {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  name      String
  icon      String?
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  articles WikiArticle[]

  @@map("wiki_categories")
}

model WikiArticle {
  id             Int      @id @default(autoincrement())
  slug           String   @unique
  wikiCategoryId Int?     @map("wiki_category_id")
  title          String
  excerpt        String?
  content        String
  order          Int      @default(0)
  isPublished    Boolean  @default(true) @map("is_published")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  category WikiCategory? @relation(fields: [wikiCategoryId], references: [id], onDelete: Restrict)

  @@map("wiki_articles")
}
