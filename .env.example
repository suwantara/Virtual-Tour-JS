# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Virtual Tour"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.up.railway.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Logging ───────────────────────────────────────────────────────────────────
# Railway menangkap stderr/stdout — gunakan "stderr" di production
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database — PostgreSQL (Railway Postgres Plugin) ────────────────────────────
# Di Railway dashboard: tambahkan plugin Postgres, lalu referensikan variabelnya:
#   DB_HOST     → ${{ Postgres.PGHOST }}
#   DB_PORT     → ${{ Postgres.PGPORT }}
#   DB_DATABASE → ${{ Postgres.PGDATABASE }}
#   DB_USERNAME → ${{ Postgres.PGUSER }}
#   DB_PASSWORD → ${{ Postgres.PGPASSWORD }}
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=virtual_tour
DB_USERNAME=postgres
DB_PASSWORD=

# ── Cache / Session / Queue ───────────────────────────────────────────────────
# Gunakan Redis jika Railway Redis plugin ditambahkan, atau "database" jika tidak
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis

# ── Redis (Railway Redis Plugin) ──────────────────────────────────────────────
# Di Railway dashboard: tambahkan plugin Redis, lalu referensikan variabelnya:
#   REDIS_HOST     → ${{ Redis.REDISHOST }}
#   REDIS_PASSWORD → ${{ Redis.REDISPASSWORD }}
#   REDIS_PORT     → ${{ Redis.REDISPORT }}
# Atau gunakan REDIS_URL → ${{ Redis.REDIS_URL }}
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Filesystem ────────────────────────────────────────────────────────────────
# Gunakan "r2" di production, "local" di development
FILESYSTEM_DISK=r2

# ── Cloudflare R2 Object Storage ──────────────────────────────────────────────
# R2 Key & Secret: Cloudflare Dashboard → R2 → Manage API Tokens
# Endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# URL publik: custom domain atau https://pub-<TOKEN>.r2.dev (aktifkan R2 public access)
CLOUDFLARE_R2_KEY=
CLOUDFLARE_R2_SECRET=
CLOUDFLARE_R2_BUCKET=virtual-tour
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Vite ──────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
